{{#if hasRedis}}
### Redis Integration
```typescript
@Injectable()
export class EntityService {
  constructor(
    private readonly entityRepository: EntityRepository,
    private readonly redisService: RedisService,
  ) {}

  async findById(id: string): Promise<EntityObject> {
    // Try cache first
    const cacheKey = `entity:${id}`;
    const cached = await this.redisService.get(cacheKey);
    
    if (cached) {
      return JSON.parse(cached);
    }

    // Fetch from database
    const entity = await this.entityRepository.findById(id);
    if (!entity) {
      throw new EntityNotFoundError();
    }

    // Cache result
    await this.redisService.set(cacheKey, JSON.stringify(entity), 3600);
    
    return new EntityObject(entity);
  }
}
```
{{/if}}

{{#if hasElasticsearch}}
### Elasticsearch Integration
```typescript
@Injectable()
export class EntitySearchService {
  constructor(private readonly elasticsearchService: ElasticsearchService) {}

  async indexEntity(entity: Entity): Promise<void> {
    await this.elasticsearchService.index({
      index: 'entities',
      id: entity.id,
      body: entity,
    });
  }

  async searchEntities(query: string): Promise<Entity[]> {
    const result = await this.elasticsearchService.search({
      index: 'entities',
      body: {
        query: {
          multi_match: {
            query,
            fields: ['name', 'description'],
          },
        },
      },
    });

    return result.body.hits.hits.map(hit => hit._source);
  }
}
```
{{/if}}

{{#if hasRabbitmq}}
### RabbitMQ Integration
```typescript
@Injectable()
export class EntityService {
  constructor(
    private readonly entityRepository: EntityRepository,
    private readonly rabbitmqService: RabbitMQService,
  ) {}

  async create(data: CreateEntityInput): Promise<EntityObject> {
    const entity = await this.entityRepository.create(data);
    
    // Publish event
    await this.rabbitmqService.publish('entity.created', {
      id: entity.id,
      name: entity.name,
      createdAt: entity.createdAt,
    });

    return new EntityObject(entity);
  }
}

// Event handler
@Injectable()
export class EntityEventHandler {
  @MessageHandler('entity.created')
  async handleEntityCreated(data: any): Promise<void> {
    console.log('Entity created:', data);
    // Handle entity creation event
  }
}
```
