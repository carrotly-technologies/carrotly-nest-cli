import { Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { EnvironmentVariables } from './env.variables';

@Injectable()
export class RabbitMQConfig {
  constructor(private readonly config: ConfigService<EnvironmentVariables>) {}

  getConnectionUrl(): string {
    const protocol = this.config.get('RABBITMQ_PROTOCOL') || 'amqp';
    const host = this.config.get('RABBITMQ_HOST') || 'localhost';
    const port = this.config.get('RABBITMQ_PORT') || '5672';
    const username = this.config.get('RABBITMQ_USERNAME') || 'guest';
    const password = this.config.get('RABBITMQ_PASSWORD') || 'guest';
    const vhost = this.config.get('RABBITMQ_VHOST') || '/';

    return `${protocol}://${username}:${password}@${host}:${port}${vhost}`;
  }

  getHost(): string {
    return this.config.get('RABBITMQ_HOST') || 'localhost';
  }

  getPort(): number {
    return parseInt(this.config.get('RABBITMQ_PORT') || '5672', 10);
  }

  getUsername(): string {
    return this.config.get('RABBITMQ_USERNAME') || 'guest';
  }

  getPassword(): string {
    return this.config.get('RABBITMQ_PASSWORD') || 'guest';
  }

  getVhost(): string {
    return this.config.get('RABBITMQ_VHOST') || '/';
  }

  getProtocol(): string {
    return this.config.get('RABBITMQ_PROTOCOL') || 'amqp';
  }

  isEnabled(): boolean {
    return this.config.get('RABBITMQ_ENABLED') === 'true';
  }

  getManagementUrl(): string {
    const host = this.getHost();
    const managementPort = this.config.get('RABBITMQ_MANAGEMENT_PORT') || '15672';
    return `http://${host}:${managementPort}`;
  }
}
