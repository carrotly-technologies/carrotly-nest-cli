import { Resolver, Query, Mutation, Args, ID } from '@nestjs/graphql';
import { ObjectType, Field, InputType, Int } from '@nestjs/graphql';

@ObjectType()
export class AppItem {
  @Field(() => ID)
  id: string;

  @Field()
  name: string;

  @Field({ nullable: true })
  description?: string;

  @Field()
  createdAt: Date;

  @Field()
  updatedAt: Date;
}

@InputType()
export class CreateAppItemInput {
  @Field()
  name: string;

  @Field({ nullable: true })
  description?: string;
}

@InputType()
export class UpdateAppItemInput {
  @Field({ nullable: true })
  name?: string;

  @Field({ nullable: true })
  description?: string;
}

@ObjectType()
export class AppInfo {
  @Field()
  name: string;

  @Field()
  description: string;

  @Field()
  version: string;

  @Field()
  timestamp: string;
}

@Resolver(() => AppItem)
export class AppResolver {
  private items: AppItem[] = [
    {
      id: '1',
      name: 'Sample Item',
      description: 'This is a sample item created by the {{projectName}} service',
      createdAt: new Date(),
      updatedAt: new Date(),
    },
  ];

  @Query(() => AppInfo, { description: 'Get application information' })
  appInfo(): AppInfo {
    return {
      name: '{{projectName}}',
      description: '{{projectDescription}}',
      version: '1.0.0',
      timestamp: new Date().toISOString(),
    };
  }

  @Query(() => [AppItem], { description: 'Get all items' })
  items(): AppItem[] {
    return this.items;
  }

  @Query(() => AppItem, { description: 'Get item by ID' })
  item(@Args('id', { type: () => ID }) id: string): AppItem {
    const item = this.items.find(item => item.id === id);
    if (!item) {
      throw new Error(`Item with ID ${id} not found`);
    }
    return item;
  }

  @Mutation(() => AppItem, { description: 'Create a new item' })
  createItem(@Args('input') input: CreateAppItemInput): AppItem {
    const newItem: AppItem = {
      id: Date.now().toString(),
      name: input.name,
      description: input.description,
      createdAt: new Date(),
      updatedAt: new Date(),
    };

    this.items.push(newItem);
    return newItem;
  }

  @Mutation(() => AppItem, { description: 'Update an item' })
  updateItem(
    @Args('id', { type: () => ID }) id: string,
    @Args('input') input: UpdateAppItemInput,
  ): AppItem {
    const itemIndex = this.items.findIndex(item => item.id === id);
    if (itemIndex === -1) {
      throw new Error(`Item with ID ${id} not found`);
    }

    const updatedItem = {
      ...this.items[itemIndex],
      ...input,
      updatedAt: new Date(),
    };

    this.items[itemIndex] = updatedItem;
    return updatedItem;
  }

  @Mutation(() => Boolean, { description: 'Delete an item' })
  deleteItem(@Args('id', { type: () => ID }) id: string): boolean {
    const itemIndex = this.items.findIndex(item => item.id === id);
    if (itemIndex === -1) {
      throw new Error(`Item with ID ${id} not found`);
    }

    this.items.splice(itemIndex, 1);
    return true;
  }
}
