import { Resolver, Query, Mutation, Args } from '@nestjs/graphql';
{{#if isMongoose}}
import { GraphQLObjectID } from 'graphql-scalars';
{{/if}}
import { ExampleObject } from '../objects/example.object';
import { ExampleCreateInput } from '../inputs/example-create.input';
import { ExampleUpdateInput } from '../inputs/example-update.input';
import { ExampleFindManyInput } from '../inputs/example-find-many.input';
import { ExampleService } from '../services/example.service';

@Resolver(() => ExampleObject)
export class ExampleResolver {
  constructor(private readonly exampleService: ExampleService) {}

  @Query(() => ExampleObject, { description: 'Get example by ID' })
  async example(
{{#if isMongoose}}
    @Args('id', { type: () => GraphQLObjectID }) id: string,
{{/if}}
{{#if isPrisma}}
    @Args('id', { type: () => String }) id: string,
{{/if}}
  ): Promise<ExampleObject> {
    const example = await this.exampleService.findById(id);
    if (!example) {
      throw new Error('Example not found');
    }
    return new ExampleObject(example);
  }

  @Query(() => [ExampleObject], { description: 'Get multiple examples' })
  async examples(
    @Args('input', { nullable: true }) input?: ExampleFindManyInput,
  ): Promise<ExampleObject[]> {
    const examples = await this.exampleService.findMany(input);
    return examples.map(example => new ExampleObject(example));
  }

  @Mutation(() => ExampleObject, { description: 'Create a new example' })
  async exampleCreate(
    @Args('input') input: ExampleCreateInput,
  ): Promise<ExampleObject> {
    const example = await this.exampleService.create(input);
    return new ExampleObject(example);
  }

  @Mutation(() => ExampleObject, { description: 'Update an existing example' })
  async exampleUpdate(
{{#if isMongoose}}
    @Args('id', { type: () => GraphQLObjectID }) id: string,
{{/if}}
{{#if isPrisma}}
    @Args('id', { type: () => String }) id: string,
{{/if}}
    @Args('input') input: ExampleUpdateInput,
  ): Promise<ExampleObject> {
    const example = await this.exampleService.updateById(id, input);
    if (!example) {
      throw new Error('Example not found');
    }
    return new ExampleObject(example);
  }

  @Mutation(() => Boolean, { description: 'Delete an example' })
  async exampleDelete(
{{#if isMongoose}}
    @Args('id', { type: () => GraphQLObjectID }) id: string,
{{/if}}
{{#if isPrisma}}
    @Args('id', { type: () => String }) id: string,
{{/if}}
  ): Promise<boolean> {
    return this.exampleService.deleteById(id);
  }
}
