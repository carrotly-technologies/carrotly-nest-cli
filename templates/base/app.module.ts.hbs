import { Module } from '@nestjs/common';
import { AppConfigModule } from './config/config.module';
import { AppDbModule } from './common/modules/app-db.module';
{{#if isGraphQL}}
import { AppGqlModule } from './common/modules/app-gql.module';
import { AppResolver } from './app.resolver';
{{/if}}
{{#if isMongoose}}
import { AppMongooseModelsModule } from './common/modules/app-mongoose-models.module';
{{/if}}
{{#if isRest}}
import { AppController } from './app.controller';
import { AppService } from './app.service';
{{/if}}
{{#if hasRedis}}
import { RedisModule } from './redis/redis.module';
{{/if}}
import { ExampleModule } from './example-module/example.module';

const commonModules = [
  AppConfigModule,
  AppDbModule,
{{#if isGraphQL}}
  AppGqlModule,
{{/if}}
{{#if isMongoose}}
  AppMongooseModelsModule,
{{/if}}
{{#if hasRedis}}
  RedisModule,
{{/if}}
];

@Module({
  imports: [
    ...commonModules,
    ExampleModule,
  ],
{{#if isRest}}
  controllers: [AppController],
  providers: [AppService],
{{/if}}
{{#if isGraphQL}}
  providers: [AppResolver],
{{/if}}
})
export class AppModule {}
