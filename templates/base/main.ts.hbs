import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';
import { Logger{{#if isRest}}, ValidationPipe{{/if}} } from '@nestjs/common';
{{#if isRest}}
import { DocumentBuilder, SwaggerModule } from '@nestjs/swagger';
{{/if}}
import { ServerConfig } from './config/server.config';

async function bootstrap() {
  const logger = new Logger('Bootstrap');
  
  const app = await NestFactory.create(AppModule, {
    logger: ['log', 'error', 'warn', 'debug', 'verbose'],
  });

  // Get configuration service
  const serverConfig = app.get(ServerConfig);
  
  // Global prefix for all routes
  app.setGlobalPrefix('api');
  
  {{#if isRest}}
  // Enable validation pipes
  app.useGlobalPipes(new ValidationPipe({
    whitelist: true,
    forbidNonWhitelisted: true,
    transform: true,
    disableErrorMessages: serverConfig.isProduction(),
  }));

  // Swagger configuration
  if (serverConfig.isDevelopment()) {
    const swaggerConfig = new DocumentBuilder()
      .setTitle(serverConfig.getAppName())
      .setDescription('{{projectDescription}}')
      .setVersion('1.0')
      .addTag('{{projectName}}')
      .build();
    
    const document = SwaggerModule.createDocument(app, swaggerConfig);
    SwaggerModule.setup('api/docs', app, document);
  }
  {{/if}}

  // CORS configuration
  app.enableCors({
    origin: serverConfig.getCorsOrigin(),
    credentials: true,
  });

  const port = serverConfig.getPort();
  await app.listen(port, '0.0.0.0');
  
  logger.log(`🚀 Application is running on: http://localhost:${port}/api`);
  {{#if isRest}}
  if (serverConfig.isDevelopment()) {
    logger.log(`📚 Swagger documentation available at: http://localhost:${port}/api/docs`);
  }
  {{/if}}
  {{#if isGraphQL}}
  if (serverConfig.isDevelopment()) {
    logger.log(`🎯 GraphQL Playground available at: http://localhost:${port}/graphql`);
  }
  {{/if}}
  logger.log(`Current environment: ${serverConfig.getEnv()}`);
  logger.log(`Debug mode: ${serverConfig.isDebug()}`);
}

bootstrap().catch((error) => {
  console.error('Error starting application:', error);
  process.exit(1);
});
