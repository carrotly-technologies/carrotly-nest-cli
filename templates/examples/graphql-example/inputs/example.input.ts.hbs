import { Field, InputType } from '@nestjs/graphql';
{{#if isMongoose}}
import { GraphQLObjectID } from 'graphql-scalars';
{{/if}}

@InputType()
export class ExampleInput {
{{#if isMongoose}}
  @Field(() => GraphQLObjectID)
  id: string;
{{/if}}
{{#if isPrisma}}
  @Field(() => String)
  id: string;
{{/if}}
}
