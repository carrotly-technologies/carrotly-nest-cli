{
  "name": "carrotly-cli",
  "version": "0.1.0",
  "description": "A modern CLI tool for scaffolding NestJS applications with comprehensive configuration support",
  "keywords": [
    "nestjs",
    "cli",
    "scaffolding",
    "typescript",
    "graphql",
    "rest",
    "prisma",
    "mongoose"
  ],
  "main": "dist/index.js",
  "bin": {
    "carrotly": "dist/bin/carrotly.js",
    "carrotly-cli": "dist/bin/carrotly.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/bin/carrotly.ts",
    "start": "node dist/bin/carrotly.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "yarn lint --fix",
    "lint:diagnostics": "tsc -p tsconfig.diagnostics.json",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "release": "./node_modules/.bin/commit-and-tag-version --no-verify",
    "release:first": "yarn release --first-release",
    "release:major": "yarn release --release-as major",
    "release:minor": "yarn release --release-as minor",
    "release:patch": "yarn release --release-as patch",
    "prepare": "husky"
  },
  "files": [
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fs-extra": "^11.1.1",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.12",
    "ora": "^5.4.1",
    "validate-npm-package-name": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "@eslint/compat": "1.2.8",
    "@eslint/js": "9.24.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "29.5.14",
    "@types/node": "22.14.0",
    "@typescript-eslint/eslint-plugin": "8.29.1",
    "commit-and-tag-version": "12.5.1",
    "eslint": "9.24.0",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-prettier": "5.2.6",
    "eslint-plugin-unused-imports": "4.1.4",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "knip": "5.50.2",
    "lint-staged": "15.5.1",
    "prettier": "3.5.3",
    "ts-jest": "29.3.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/filipkostecki/carrotly-cli.git"
  },
  "bugs": {
    "url": "https://github.com/filipkostecki/carrotly-cli/issues"
  },
  "homepage": "https://github.com/filipkostecki/carrotly-cli#readme",
  "author": "Filip Kostecki",
  "license": "MIT",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
